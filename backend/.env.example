# Node
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Origin of the SPA — used for CORS + OAuth redirect target.
APP_URL=http://localhost:5173

# MongoDB (Atlas). Include a database name in the path (e.g. /shiplog).
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/shiplog?retryWrites=true&w=majority

# Session + token encryption secrets.
# Generate each with:  openssl rand -base64 32
SESSION_JWT_SECRET=
TOKEN_ENC_KEY=

# GitHub OAuth App (https://github.com/settings/developers)
# In dev the SPA runs on :5173 and proxies /api to the backend, so the callback URL
# must point at the SPA origin (:5173) to keep everything single-origin.
# The OAuth App's "Authorization callback URL" MUST equal GITHUB_OAUTH_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user,public_repo

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

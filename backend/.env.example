# Node
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Origin of the SPA — used for CORS + OAuth redirect target.
APP_URL=http://localhost:5173

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://shiplog:shiplog@localhost:5432/shiplog?schema=public

# Session + token encryption secrets.
# Generate each with:  openssl rand -base64 32
SESSION_JWT_SECRET=
TOKEN_ENC_KEY=

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL MUST equal GITHUB_OAUTH_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user,public_repo

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

{
  "name": "shiplog",
  "version": "0.1.0",
  "private": true,
  "description": "ShipLog clone — AI-powered changelog generator",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @shiplog/backend",
    "dev:web": "npm run dev -w @shiplog/frontend",
    "build": "npm run build -w @shiplog/backend && npm run build -w @shiplog/frontend",
    "typecheck": "npm run typecheck -w @shiplog/backend && npm run typecheck -w @shiplog/frontend",
    "db:push": "npm run prisma:push -w @shiplog/backend",
    "db:seed": "npm run prisma:seed -w @shiplog/backend",
    "db:studio": "npm run prisma:studio -w @shiplog/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
